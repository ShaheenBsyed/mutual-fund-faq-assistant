# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class

# Test cache
.pytest_cache/

# Environments — KEEP .env out of git (use HF Spaces Secrets instead)
.env
.venv/
venv/
ENV/
env/

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Scratch and temp files
scratch/
tmp/
temp/

# NOTE: data/ is intentionally NOT ignored.
# data/vector_db/ and data/processed/corpus.json must be committed
# so that Hugging Face Spaces has the pre-built ChromaDB index ready
# without needing to re-run the ingestion pipeline on startup.
